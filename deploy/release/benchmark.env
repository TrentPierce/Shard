# Benchmark profile overrides for release-matrix runs.
# Apply on top of rc1.env for apples-to-apples performance tests.

SHARD_RELEASE_PROFILE=benchmark-2026-03-05

# Prevent benchmark traffic from being dominated by policy throttling.
SHARD_RATE_LIMIT_DEFAULT=600
SHARD_RATE_LIMIT_IP=300
SHARD_RATE_LIMIT_BURST=120

# Keep benchmark traffic focused on verifier/scout behavior instead of
# bootstrap-health gating transients.
SHARD_BOOTSTRAP_REFUSE_WORK_BELOW_MIN=false
