# Benchmark profile overrides for release-matrix runs.
# Apply on top of rc1.env for apples-to-apples performance tests.

SHARD_RELEASE_PROFILE=benchmark-2026-03-05
SHARD_CORS_ORIGINS=https://shardnetwork.live,http://127.0.0.1:3000,http://localhost:3000

# Prevent benchmark traffic from being dominated by policy throttling.
SHARD_RATE_LIMIT_DEFAULT=600
SHARD_RATE_LIMIT_IP=300
SHARD_RATE_LIMIT_BURST=120

# Keep benchmark traffic focused on verifier/scout behavior instead of
# bootstrap-health gating transients.
SHARD_BOOTSTRAP_REFUSE_WORK_BELOW_MIN=false

# Align remote daemon runtime with current saturation-control defaults.
SHARD_SCOUT_TIMEOUT_MS=1400
SHARD_SCOUT_BACKPRESSURE_START_QUEUE_DEPTH=4
SHARD_SCOUT_ACTIVE_CAP=6
SHARD_SCOUT_ACTIVE_CAP_SOFT=4
SHARD_SCOUT_ACTIVE_CAP_HARD=2
SHARD_SCOUT_TIMEOUT_MIN_ACTIVE=1
SHARD_SCOUT_TIMEOUT_LOW_SUPPLY_MS=1400
SHARD_SCOUT_PROBE_EVERY_N=1
# Browser scouts now poll every 200ms (NEXT_PUBLIC_SCOUT_POLL_INTERVAL_MS=200), so
# average work-pickup latency dropped from ~450ms to ~100ms.  A probe timeout of
# 600ms gives ~250ms headroom above the expected ~350ms round-trip.
SHARD_SCOUT_PROBE_TIMEOUT_MS=600
SHARD_SCOUT_DRAFT_TOKEN_COUNT=3
SHARD_SPECULATIVE_MIN_REQUEST_TOKENS=12
SHARD_SCOUT_LONG_REQUEST_MIN_TOKENS=32
SHARD_SCOUT_LONG_REQUEST_DRAFT_TOKEN_COUNT=8
SHARD_SCOUT_TIMEOUT_SHORT_REQUEST_MAX_TOKENS=12
SHARD_SCOUT_TIMEOUT_SHORT_REQUEST_CAP_MS=300
SHARD_SCOUT_TIMEOUT_VERIFIER_RATIO=0.55
SHARD_SCOUT_TIMEOUT_VERIFIER_FLOOR_MS=200
SHARD_SCOUT_TIMEOUT_VERIFIER_CEIL_MS=1400
# Draft token acceptance policy.  The verifier accepts a scout token if ANY of:
#   1. greedy match (draft == verifier argmax)
#   2. draft token is in verifier's top-SHARD_SPECULATIVE_TOP_K predictions
#   3. logit gap (best_logit - draft_logit) < SHARD_SPECULATIVE_LOGIT_TOLERANCE
# Default top_k=20 is too tight for a 1B browser scout vs a larger verifier model;
# top_k=50 is still highly selective (top 0.04% of 128K vocab) but tolerates the
# cross-model-size distribution mismatch that causes near-zero acceptance rates.
SHARD_SPECULATIVE_TOP_K=50
SHARD_LOCAL_SCOUT_FALLBACK=false
SHARD_VERIFIER_QUEUE_CAP=2
SHARD_VERIFIER_TARGET_QUEUE_WAIT_MS=3500

# Keep verifier routing mesh-first during benchmark runs so local queue pressure
# can offload into healthier peers instead of pretending each node is isolated.
SHARD_MESH_FORWARD_ENABLED=true
SHARD_MESH_FORWARD_MAX_HOPS=1
SHARD_MESH_FORWARD_PROBE_LIMIT=4
SHARD_MESH_FORWARD_PROBE_TIMEOUT_MS=600
SHARD_MESH_FORWARD_TIMEOUT_MS=8000
SHARD_MESH_FORWARD_QUEUE_WEIGHT_MS=120
SHARD_MESH_FORWARD_MIN_IMPROVEMENT_MS=120
SHARD_MESH_FORWARD_LOCAL_QUEUE_TRIGGER=2
