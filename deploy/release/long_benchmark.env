# Long benchmark profile overrides for 64-token scout-engagement runs.
# Apply on top of rc1.env when validating long-generation verifier/scout behavior.

SHARD_RELEASE_PROFILE=long-benchmark-2026-03-06
SHARD_CORS_ORIGINS=https://shardnetwork.live,http://127.0.0.1:3000,http://localhost:3000

# Keep benchmark traffic focused on verifier/scout behavior instead of
# bootstrap-health gating transients.
SHARD_BOOTSTRAP_REFUSE_WORK_BELOW_MIN=false

# Prevent policy throttles from dominating long benchmark runs.
SHARD_RATE_LIMIT_DEFAULT=600
SHARD_RATE_LIMIT_IP=300
SHARD_RATE_LIMIT_BURST=120

# Long-request speculative behavior. This profile is intentionally looser than
# short RC stability so 64-token requests can establish a clean no-scout
# baseline before we judge scout uplift.
SHARD_SCOUT_TIMEOUT_MS=1800
SHARD_SCOUT_TIMEOUT_LOW_SUPPLY_MS=1800
SHARD_SCOUT_TIMEOUT_MIN_ACTIVE=1
SHARD_SCOUT_PROBE_EVERY_N=1
# Browser scouts now poll every 200ms (NEXT_PUBLIC_SCOUT_POLL_INTERVAL_MS=200), so
# average work-pickup latency dropped from ~450ms to ~100ms.  A probe timeout of
# 700ms gives ~350ms headroom above the expected ~350ms round-trip.
SHARD_SCOUT_PROBE_TIMEOUT_MS=700
SHARD_SCOUT_DRAFT_TOKEN_COUNT=3
SHARD_SPECULATIVE_MIN_REQUEST_TOKENS=12
SHARD_SCOUT_LONG_REQUEST_MIN_TOKENS=32
SHARD_SCOUT_LONG_REQUEST_DRAFT_TOKEN_COUNT=8
SHARD_SCOUT_TIMEOUT_SHORT_REQUEST_MAX_TOKENS=12
SHARD_SCOUT_TIMEOUT_SHORT_REQUEST_CAP_MS=300
SHARD_SCOUT_TIMEOUT_VERIFIER_RATIO=0.70
SHARD_SCOUT_TIMEOUT_VERIFIER_RATIO_LONG=1.50
SHARD_SCOUT_TIMEOUT_VERIFIER_FLOOR_MS=600
SHARD_SCOUT_TIMEOUT_VERIFIER_CEIL_MS=2200
SHARD_SCOUT_TIMEOUT_ACCEPTANCE_FLOOR_LONG_MS=800
# Draft token acceptance policy — same reasoning as benchmark.env.
# Also raise logit tolerance slightly (18→25) for long requests: with 64 tokens
# the distribution mismatch between 1B and larger model means the gap between
# the 1B model's choice and the verifier's best can often land in the 18-25 range.
SHARD_SPECULATIVE_TOP_K=50
SHARD_SPECULATIVE_LOGIT_TOLERANCE=25.0
SHARD_LOCAL_SCOUT_FALLBACK=false

# Long-run verifier admission. This is separate from short RC because long
# generations need more in-flight headroom to avoid collapsing into `503`
# before the scout path can be judged honestly.
SHARD_VERIFIER_QUEUE_CAP=6
SHARD_VERIFIER_TARGET_QUEUE_WAIT_MS=6000

# Keep verifier routing mesh-first during long benchmark runs.
SHARD_MESH_FORWARD_ENABLED=true
SHARD_MESH_FORWARD_MAX_HOPS=1
SHARD_MESH_FORWARD_PROBE_LIMIT=4
SHARD_MESH_FORWARD_PROBE_TIMEOUT_MS=600
SHARD_MESH_FORWARD_TIMEOUT_MS=8000
SHARD_MESH_FORWARD_QUEUE_WEIGHT_MS=120
SHARD_MESH_FORWARD_MIN_IMPROVEMENT_MS=120
SHARD_MESH_FORWARD_LOCAL_QUEUE_TRIGGER=2
