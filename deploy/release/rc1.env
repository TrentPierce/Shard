# Shard release-candidate runtime profile (frozen)
# Date: 2026-03-04
# Scope: scout scheduling, backpressure, and verifier admission controls

SHARD_RELEASE_PROFILE=rc1-2026-03-04

# Scout work queue and wait behavior
SHARD_SCOUT_TIMEOUT_MS=1500
SHARD_SCOUT_WORK_QUEUE_MAX=1024

# Backpressure thresholds
SHARD_SCOUT_BACKPRESSURE_START_QUEUE_DEPTH=256
SHARD_SCOUT_BACKPRESSURE_LATENCY_WARN_MS=3000
SHARD_SCOUT_BACKPRESSURE_LATENCY_SEVERE_MS=6000

# Admission thresholds and retry hints
SHARD_SCOUT_ADMISSION_QUEUE_DEPTH=5
SHARD_SCOUT_ADMISSION_QUEUE_HARD_DEPTH=10
SHARD_SCOUT_ADMISSION_LATENCY_SOFT_MS=4500
SHARD_SCOUT_ADMISSION_LATENCY_HARD_MS=6000

# Per-scout pacing limits
SHARD_SCOUT_POLL_MIN_INTERVAL_MS=75
SHARD_SCOUT_DRAFT_MIN_INTERVAL_MS=50

# Active scout cap by admission mode
SHARD_SCOUT_ACTIVE_CAP=8
SHARD_SCOUT_ACTIVE_CAP_SOFT=4
SHARD_SCOUT_ACTIVE_CAP_HARD=2

# Verifier overload protection
SHARD_VERIFIER_QUEUE_CAP=2
SHARD_VERIFIER_TARGET_QUEUE_WAIT_MS=3500

# Mesh-forwarding defaults. Verifiers should behave like a mesh, not isolated
# endpoints, even before scout traffic is healthy enough to help.
SHARD_MESH_FORWARD_ENABLED=true
SHARD_MESH_FORWARD_MAX_HOPS=1
SHARD_MESH_FORWARD_PROBE_LIMIT=4
SHARD_MESH_FORWARD_PROBE_TIMEOUT_MS=600
SHARD_MESH_FORWARD_TIMEOUT_MS=8000
SHARD_MESH_FORWARD_QUEUE_WEIGHT_MS=120
SHARD_MESH_FORWARD_MIN_IMPROVEMENT_MS=120
SHARD_MESH_FORWARD_LOCAL_QUEUE_TRIGGER=2
