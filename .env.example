# Core runtime
SHARD_API_KEYS=
SHARD_REQUIRE_API_KEY=false
SHARD_RATE_LIMIT_PER_MINUTE=120
SHARD_SCOUT_RATE_LIMIT_PER_MINUTE=180
SHARD_MAX_PROMPT_CHARS=16000
SHARD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SHARD_LOG_LEVEL=INFO

# Optional public deployment switches
SHARD_PUBLIC_API=false
SHARD_PUBLIC_HOST=

# BitNet runtime wiring
BITNET_LIB=
BITNET_MODEL=

# Monitoring stack credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
