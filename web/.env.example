# Shard Web Client Environment Configuration
# Copy this file to .env.local and update the values for your deployment

# Public canonical site URL
NEXT_PUBLIC_SITE_URL=https://shardnetwork.live

# Browser-facing API base URL.
# For Vercel/proxied deployment, prefer /api.
NEXT_PUBLIC_API_URL=/api

# Rust sidecar URL for local tooling.
NEXT_PUBLIC_RUST_URL=http://127.0.0.1:9091

# Prefer local shard mode when localhost daemon is detected.
NEXT_PUBLIC_PREFER_LOCAL_SHARD=false

# Optional API key for authenticated gateways.
NEXT_PUBLIC_SHARD_API_KEY=

# Server-side backend resolver for Next.js API routes.
# Priority in server routes: SHARD_BACKEND_URL -> NEXT_PUBLIC_SHARD_BACKEND_URL -> NEXT_PUBLIC_API_URL -> fallback public IP.
SHARD_BACKEND_URL=http://35.175.242.222:9091

# Optional public backend for clients/tools that need direct endpoint visibility.
NEXT_PUBLIC_SHARD_BACKEND_URL=http://35.175.242.222:9091
