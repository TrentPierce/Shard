# Cloudflare Workers Environment Variables
# Reference - add these in Cloudflare Dashboard → Workers & Pages → shard-web → Settings → Variables

NEXT_PUBLIC_SITE_URL=https://shardnetwork.live
NEXT_PUBLIC_API_URL=/api
SHARD_BACKEND_URL=http://your-daemon-ip:9091
NEXT_PUBLIC_SHARD_BACKEND_URL=http://your-daemon-ip:9091
NEXT_PUBLIC_RUST_URL=http://127.0.0.1:9091
NEXT_PUBLIC_PREFER_LOCAL_SHARD=false
