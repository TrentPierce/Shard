{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shard.network/schemas/v1.chat-completions.request.schema.json",
  "title": "Chat Completions Request",
  "type": "object",
  "required": ["messages"],
  "additionalProperties": true,
  "properties": {
    "model": { "type": "string" },
    "stream": { "type": "boolean" },
    "max_tokens": { "type": "integer", "minimum": 1 },
    "max_new_tokens": { "type": "integer", "minimum": 1 },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": { "type": "string", "enum": ["system", "user", "assistant"] },
          "content": { "type": "string" }
        }
      }
    }
  }
}

