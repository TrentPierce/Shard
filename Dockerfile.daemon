FROM rust:1.78-slim as builder
WORKDIR /app
COPY desktop/rust/ ./desktop/rust/
RUN cd desktop/rust && cargo build --release --bin shard-daemon

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/desktop/rust/target/release/shard-daemon /usr/local/bin/
EXPOSE 9091 4001 9090/udp 9092/udp
ENTRYPOINT ["shard-daemon"]
